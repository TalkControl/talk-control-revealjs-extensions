{
    "lint-on-edit": {
        "PostToolUse": [
            {
                "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // .tool_input.TargetFile // \"\"' | { read -r f; ./.hooks/post-file-change.sh \"$f\"; } || true",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
