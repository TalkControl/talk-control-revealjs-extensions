{
    "hooks": {
        "AfterTool": [
            {
                "matcher": "write_file|replace",
                "hooks": [
                    {
                        "type": "command",
                        "command": "FILE=$(echo $GEMINI_TOOL_INPUT | jq -r '.file_path // \"\"'); ./.hooks/post-file-change.sh \"$FILE\" || true",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
