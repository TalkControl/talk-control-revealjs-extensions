{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; \"${CLAUDE_PROJECT_DIR:-.}/.hooks/post-file-change.sh\" \"$f\"; } || true",
                        "timeout": 60,
                        "statusMessage": "Formatting changed file..."
                    }
                ]
            }
        ]
    }
}
