{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // \"\"' | { read -r f; [[ \"$f\" =~ /src/.*\\.(ts|scss)$ ]] && npm run lint:fix && npm run prettier:fix; } 2>/dev/null || true",
                        "timeout": 60,
                        "statusMessage": "Linting & formatting src/..."
                    }
                ]
            }
        ]
    }
}
